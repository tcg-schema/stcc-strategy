stcc:OpBanner a stcc:OperationKind ; rdfs:label "banner" ; schema:inDefinedTermSet stcc:operationKinds ; stcc:jsonValue "banner" ;
  stcc:operationCategory "banner" .


stcc:setupPositions a schema:DefinedTermSet ;
  rdfs:label "Setup positions" ;
  rdfs:comment "The printed position indicator: where a card starts the game." .
