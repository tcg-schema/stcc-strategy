stcc:operationKinds a schema:DefinedTermSet ;
  rdfs:label "Operation kinds" ;
  rdfs:comment "The keyword band printed on an operation strip." .
stcc:OpPlay a stcc:OperationKind ; rdfs:label "play" ; schema:inDefinedTermSet stcc:operationKinds ; stcc:jsonValue "play" ;
  stcc:operationCategory "play" .
