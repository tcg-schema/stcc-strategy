stcc:specialties a schema:DefinedTermSet ;
  rdfs:label "Specialties" ;
  rdfs:comment "Rulebook p.17 icon specialties." .
stcc:SpecialtyResearch a stcc:Specialty ; rdfs:label "Research" ; schema:inDefinedTermSet stcc:specialties ; stcc:jsonValue "Research" .
