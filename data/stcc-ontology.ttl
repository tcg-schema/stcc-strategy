stcc:printingVariants a schema:DefinedTermSet ;
  rdfs:label "Printing variants" ;
  rdfs:comment "Read from the marker on the printed card number: none = original, bullet = reprint, dagger = updated." .
stcc:VariantOriginal a stcc:PrintingVariant ; rdfs:label "original" ; schema:inDefinedTermSet stcc:printingVariants ; stcc:jsonValue "original" .
